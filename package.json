{
  "name": "ytdl-flow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "3.1.13",
  "description": "A modern YouTube Downloader based on yt-dlp and Tauri",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22 <23"
  },
  "scripts": {
    "setup-sidecars": "bun scripts/setup-sidecars.mjs",
    "frontend:dev": "bun --bun vite",
    "dev-port": "bun scripts/dev-port.mjs",
    "cleanup": "bun scripts/cleanup.mjs",
    "dev": "bun run setup-sidecars && bun run frontend:dev",
    "check:versions": "bun scripts/check-versions.mjs",
    "verify:fast": "bun run --parallel --no-exit-on-error typecheck typecheck:ui lint check:versions check:repository",
    "build": "bun scripts/build.mjs",
    "build:web": "bun --bun vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "release:prepare": "bun scripts/release.mjs",
    "test": "vitest run",
    "test:application": "vitest run --root packages/application",
    "test:domain": "vitest run --root packages/domain",
    "test:contracts": "vitest run --root packages/contracts",
    "test:packages": "bun run test:application && bun run test:domain && bun run test:contracts",
    "test:ui-shell": "bun scripts/run-app-shell-audit.mjs",
    "test:ui-download-list": "bun scripts/run-download-list-ui-matrix.mjs",
    "test:ui-input": "bun scripts/run-input-section-ui-matrix.mjs",
    "test:ui-settings": "bun scripts/run-settings-panel-ui-matrix.mjs",
    "test:ui-matrix": "bun run test:ui-shell && bun run test:ui-download-list && bun run test:ui-input && bun run test:ui-settings",
    "update-bins": "bun scripts/cleanup-bins.mjs && bun scripts/prepare-release-sidecars.mjs && bun scripts/setup-sidecars.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fast": "biome lint .",
    "biome:check": "biome check .",
    "tauri:dev": "bun run dev-port && tauri dev",
    "tauri:build": "bun scripts/tauri-build.mjs",
    "test:ui-geometry": "bun scripts/run-app-shell-geometry.mjs",
    "test:ui-logs": "bun scripts/run-log-console-audit.mjs",
    "typecheck:ui": "vue-tsc --noEmit -p tsconfig.ui.json",
    "check:repository": "bun scripts/check-repository-content.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "3.5.43",
    "vue-i18n": "^11.4.12",
    "@ytdl-flow/application": "workspace:*",
    "@ytdl-flow/contracts": "workspace:*",
    "@ytdl-flow/domain": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
